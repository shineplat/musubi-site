---
---
<section class="ecosystem" id="coordination">
	<div class="container">
		<div class="section-title-container">
			<span class="section-subtitle" data-i18n="eco.subtitle">Connected 3PL Network</span>
			<h2 class="section-title" data-i18n="eco.title">Coordinating Across the Logistics Ecosystem</h2>
			<p class="section-desc" data-i18n="eco.desc">
				Bring international manufacturers, local 3PL warehouses, freight carriers, and regional distributors together on a unified digital platform.
			</p>
		</div>
		
		<div class="tabs-container">
			<!-- Tab Switchers -->
			<div class="tabs-header glass-card">
				<button class="tab-btn active" data-tab="exporters">
					<span class="tab-jp">輸出企業</span>
					<span class="tab-en" data-i18n="eco.tab1En">For Exporters</span>
				</button>
				<button class="tab-btn" data-tab="partners-tab">
					<span class="tab-jp">物流・倉庫パートナー</span>
					<span class="tab-en" data-i18n="eco.tab2En">For 3PLs & Carriers</span>
				</button>
				<button class="tab-btn" data-tab="distributors-tab">
					<span class="tab-jp">ディストリビューター</span>
					<span class="tab-en" data-i18n="eco.tab3En">For Distributors</span>
				</button>
			</div>
			
			<!-- Tab Content Panels -->
			<div class="tabs-content">
				<!-- Panel 1: Exporters -->
				<div class="tab-panel active" id="exporters">
					<div class="panel-grid">
						<div class="panel-info">
							<h3 data-i18n="eco.expTitle">Direct & Predictable US Market Entry</h3>
							<p class="panel-lead" data-i18n="eco.expLead">Empowering Japanese precision manufacturers to coordinate directly with US 3PL warehouses and freight carriers.</p>
							
							<div class="feature-bullets">
								<div class="bullet-item">
									<div class="bullet-icon">✓</div>
									<div class="bullet-text">
										<strong data-i18n="eco.expBullet1Title">Bilingual Catalog Management:</strong>
										<span data-i18n="eco.expBullet1Desc">Dual JP/EN entry for technical mechanical specifications, tolerance dimensions, and serial tracking.</span>
									</div>
								</div>
								<div class="bullet-item">
									<div class="bullet-icon">✓</div>
									<div class="bullet-text">
										<strong data-i18n="eco.expBullet2Title">Streamlined Customs Documentation:</strong>
										<span data-i18n="eco.expBullet2Desc">Pre-validated digital checklists for ISF 10+2, EPA TSCA disclosures, and HTS classifications.</span>
									</div>
								</div>
								<div class="bullet-item">
									<div class="bullet-icon">✓</div>
									<div class="bullet-text">
										<strong data-i18n="eco.expBullet3Title">End-to-End Milestone Tracking:</strong>
										<span data-i18n="eco.expBullet3Desc">Real-time visibility from factory departure to port customs clearance and 3PL dock receiving.</span>
									</div>
								</div>
							</div>
						</div>
						<div class="panel-visual">
							<div class="glass-card feature-preview-card">
								<div class="preview-header" data-i18n="eco.expVisualHeader">Customs & Compliance Hub</div>
								<div class="compliance-checklist">
									<div class="check-item verified">
										<span class="check-box">✓</span>
										<span class="check-label" data-i18n="eco.expCheck1">Bilingual Cataloging (JP/EN)</span>
									</div>
									<div class="check-item verified">
										<span class="check-box">✓</span>
										<span class="check-label" data-i18n="eco.expCheck2">EPA TSCA Disclosure Form</span>
									</div>
									<div class="check-item verified">
										<span class="check-box">✓</span>
										<span class="check-label" data-i18n="eco.expCheck3">Importer Security Filing (10+2)</span>
									</div>
									<div class="check-item verified">
										<span class="check-box">✓</span>
										<span class="check-label" data-i18n="eco.expCheck4">Customs Bond Verification</span>
									</div>
								</div>
								<div class="preview-actions">
									<button class="btn btn-primary btn-sm" data-i18n="eco.expVisualBtn">Verified For US Port Clearance</button>
								</div>
							</div>
						</div>
					</div>
				</div>
				
				<!-- Panel 2: Logistics Partners -->
				<div class="tab-panel" id="partners-tab">
					<div class="panel-grid">
						<div class="panel-info">
							<h3 data-i18n="eco.logTitle">Coordinated Inbound Logistics & Handoffs</h3>
							<p class="panel-lead" data-i18n="eco.logLead">Standardize communication between ocean drayage, 3PL receiving docks, and domestic trucking carriers.</p>
							
							<div class="feature-bullets">
								<div class="bullet-item">
									<div class="bullet-icon">✓</div>
									<div class="bullet-text">
										<strong data-i18n="eco.logBullet1Title">Dock Appointment & Receiving SOPs:</strong>
										<span data-i18n="eco.logBullet1Desc">Standardized bilingual carton labeling and warehouse pick/pack instructions prevent receiving delays.</span>
									</div>
								</div>
								<div class="bullet-item">
									<div class="bullet-icon">✓</div>
									<div class="bullet-text">
										<strong data-i18n="eco.logBullet2Title">Audited Transfer of Custody:</strong>
										<span data-i18n="eco.logBullet2Desc">Digital sign-off, container seal verification, and carton condition logs eliminate freight disputes.</span>
									</div>
								</div>
								<div class="bullet-item">
									<div class="bullet-icon">✓</div>
									<div class="bullet-text">
										<strong data-i18n="eco.logBullet3Title">Optimized Warehouse Capacity:</strong>
										<span data-i18n="eco.logBullet3Desc">Pre-planned storage bay allocation and cross-dock scheduling reduce warehouse dwell time.</span>
									</div>
								</div>
							</div>
						</div>
						<div class="panel-visual">
							<div class="glass-card feature-preview-card">
								<div class="preview-header" data-i18n="eco.custodyHeader">Custody Transfer Protocol (Design Model)</div>
								
								<div class="transfer-stepper">
									<div class="step-line">
										<div class="step-dot completed">1</div>
										<div class="step-info">
											<span class="step-name" data-i18n="eco.step1Name">Carrier Pickup Logged</span>
											<span class="step-meta" data-i18n="eco.step1Meta">Seal Verified • Digital BOL Matched</span>
										</div>
									</div>
									<div class="step-line">
										<div class="step-dot active">2</div>
										<div class="step-info">
											<span class="step-name" data-i18n="eco.step2Name">Warehouse Gate-In & Scan</span>
											<span class="step-meta" data-i18n="eco.step2Meta">Inspecting Carton Condition & Pallet Count</span>
										</div>
									</div>
								</div>
								
								<div class="inspection-form">
									<div class="inp-row">
										<label data-i18n="eco.inpRow1Label">Carton Count Check:</label>
										<span class="badge-tag" data-i18n="eco.inpRow1Badge">Matched (No Discrepancies)</span>
									</div>
									<div class="inp-row">
										<label data-i18n="eco.inpRow2Label">Cargo Condition Log:</label>
										<span class="badge-tag tag-success" data-i18n="eco.inpRow2Badge">Clean (Photo Attached)</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				
				<!-- Panel 3: Distributors -->
				<div class="tab-panel" id="distributors-tab">
					<div class="panel-grid">
						<div class="panel-info">
							<h3 data-i18n="eco.distTitle">On-Time Delivery & Inventory Clarity</h3>
							<p class="panel-lead" data-i18n="eco.distLead">Give regional distributors reliable arrival timelines and direct visibility into regional warehouse stock.</p>
							
							<div class="feature-bullets">
								<div class="bullet-item">
									<div class="bullet-icon">✓</div>
									<div class="bullet-text">
										<strong data-i18n="eco.distBullet1Title">Predictable Arrival ETAs:</strong>
										<span data-i18n="eco.distBullet1Desc">Live milestone alerts keep distributors informed from ocean departure through final-mile dispatch.</span>
									</div>
								</div>
								<div class="bullet-item">
									<div class="bullet-icon">✓</div>
									<div class="bullet-text">
										<strong data-i18n="eco.distBullet2Title">Regional Stock Allocation:</strong>
										<span data-i18n="eco.distBullet2Desc">Pull critical components from Carson or Midwest hubs with 1-2 day turnaround instead of overseas lead times.</span>
									</div>
								</div>
								<div class="bullet-item">
									<div class="bullet-icon">✓</div>
									<div class="bullet-text">
										<strong data-i18n="eco.distBullet3Title">Digital Proof of Delivery:</strong>
										<span data-i18n="eco.distBullet3Desc">Instant access to packing slips, lot numbers, and signed receiving documents for warranty compliance.</span>
									</div>
								</div>
							</div>
						</div>
						<div class="panel-visual">
							<div class="glass-card feature-preview-card">
								<div class="preview-header" data-i18n="eco.distVisualHeader">Distributor Tracking (Concept Mockup)</div>
								<div class="compliance-checklist">
									<div class="check-item verified">
										<span class="check-box">✓</span>
										<div class="step-info">
											<span class="check-label" data-i18n="eco.distCheck1">Sample Order: Industrial Components</span>
											<span class="step-meta" data-i18n="eco.distCheck1Sub">Pallet Lot Serial Verification</span>
										</div>
									</div>
									<div class="check-item verified">
										<span class="check-box">✓</span>
										<div class="step-info">
											<span class="check-label" data-i18n="eco.distCheck2">Allocated Hub: Carson, CA</span>
											<span class="step-meta" data-i18n="eco.distCheck2Sub">Staged for Regional Delivery</span>
										</div>
									</div>
									<div class="check-item verified">
										<span class="check-box">✓</span>
										<div class="step-info">
											<span class="check-label" data-i18n="eco.distCheck3">Milestone: Final-Mile In-Transit</span>
											<span class="step-meta" data-i18n="eco.distCheck3Sub">Estimated Arrival Window Provided</span>
										</div>
									</div>
								</div>
								<div class="preview-actions">
									<button class="btn btn-primary btn-sm" data-i18n="eco.distVisualBtn">Sample Digital BOL & Packing Slip</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.ecosystem {
		background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
		border-bottom: 1px solid var(--card-border);
	}

	.tabs-container {
		display: flex;
		flex-direction: column;
		gap: 30px;
		max-width: 1000px;
		margin: 0 auto;
	}

	.tabs-header {
		display: flex;
		padding: 6px;
		border-radius: 9999px;
		justify-content: space-between;
		background: rgba(14, 19, 32, 0.4);
	}

	.tab-btn {
		flex: 1;
		background: transparent;
		border: none;
		padding: 12px 24px;
		border-radius: 9999px;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		align-items: center;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.tab-btn.active {
		background: var(--bg-tertiary);
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
		border: 1px solid rgba(255, 255, 255, 0.05);
	}

	.tab-jp {
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--accent-primary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 2px;
	}

	.tab-btn:not(.active) .tab-jp {
		color: var(--text-muted);
	}

	.tab-en {
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 600;
		color: var(--text-primary);
	}

	.tab-btn:not(.active) .tab-en {
		color: var(--text-secondary);
	}

	.tab-btn:hover:not(.active) {
		background: rgba(255, 255, 255, 0.02);
	}

	.tab-panel {
		display: none;
		animation: fade-in-panel 0.4s ease-out forwards;
	}

	.tab-panel.active {
		display: block;
	}

	@keyframes fade-in-panel {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.panel-grid {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 50px;
		align-items: center;
	}

	.panel-info h3 {
		font-size: 1.8rem;
		margin-bottom: 12px;
		color: var(--text-primary);
	}

	.panel-lead {
		font-size: 1.05rem;
		color: var(--text-secondary);
		margin-bottom: 30px;
	}

	.feature-bullets {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.bullet-item {
		display: flex;
		gap: 16px;
		align-items: flex-start;
	}

	.bullet-icon {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: rgba(0, 242, 254, 0.1);
		color: var(--accent-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 800;
		font-size: 0.75rem;
		flex-shrink: 0;
		border: 1px solid rgba(0, 242, 254, 0.2);
	}

	.bullet-text {
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--text-secondary);
	}

	.bullet-text strong {
		color: var(--text-primary);
		display: block;
		margin-bottom: 2px;
	}

	/* Preview Card components */
	.feature-preview-card {
		padding: 24px;
		background: rgba(21, 28, 46, 0.4);
	}

	.preview-header {
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 20px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border-bottom: 1px solid var(--card-border);
		padding-bottom: 10px;
	}

	/* Compliance Checklist */
	.compliance-checklist {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-bottom: 20px;
	}

	.check-item {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 0.88rem;
		padding: 10px;
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.01);
		border: 1px solid var(--card-border);
	}

	.check-item.verified {
		border-color: rgba(16, 185, 129, 0.2);
		background: rgba(16, 185, 129, 0.02);
	}

	.check-box {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.7rem;
		font-weight: 800;
	}

	.verified .check-box {
		background: var(--accent-success);
		color: #080b11;
	}

	.pending .check-box {
		background: rgba(255, 255, 255, 0.1);
		color: var(--text-muted);
	}

	.check-label {
		color: var(--text-primary);
		font-weight: 500;
	}

	.preview-actions button {
		width: 100%;
		font-size: 0.85rem;
	}

	/* Custody Transfer stepper */
	.transfer-stepper {
		display: flex;
		flex-direction: column;
		gap: 20px;
		margin-bottom: 20px;
	}

	.step-line {
		display: flex;
		gap: 16px;
		align-items: flex-start;
		position: relative;
	}

	.step-line:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 26px;
		left: 12px;
		width: 2px;
		height: 24px;
		background: var(--card-border);
	}

	.step-dot {
		width: 26px;
		height: 26px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.8rem;
		font-weight: 700;
		background: var(--bg-tertiary);
		border: 1.5px solid var(--card-border);
	}

	.step-dot.completed {
		background: var(--accent-success);
		color: #080b11;
		border-color: var(--accent-success);
	}

	.step-dot.active {
		background: var(--accent-primary);
		color: #080b11;
		border-color: var(--accent-primary);
		box-shadow: 0 0 10px rgba(0, 242, 254, 0.4);
	}

	.step-info {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.step-name {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--text-primary);
	}

	.step-meta {
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.inspection-form {
		border-top: 1px solid var(--card-border);
		padding-top: 16px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.inp-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.85rem;
	}

	.inp-row label {
		color: var(--text-muted);
	}

	.badge-tag {
		background: rgba(255, 255, 255, 0.05);
		padding: 2px 8px;
		border-radius: 4px;
		color: var(--text-primary);
		font-weight: 500;
		font-size: 0.75rem;
	}

	.badge-tag.tag-success {
		background: rgba(16, 185, 129, 0.1);
		color: var(--accent-success);
		border: 1px solid rgba(16, 185, 129, 0.2);
	}

	/* Comparison Table */
	.comparison-table-wrapper {
		overflow-x: auto;
	}

	.comparison-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.85rem;
		text-align: left;
	}

	.comparison-table th, 
	.comparison-table td {
		padding: 10px 8px;
		border-bottom: 1px solid var(--card-border);
	}

	.comparison-table th {
		color: var(--text-muted);
		font-weight: 600;
		text-transform: uppercase;
		font-size: 0.72rem;
		letter-spacing: 0.05em;
	}

	.comparison-table th.highlight,
	.comparison-table td.highlight-val {
		color: var(--accent-primary);
		font-weight: 600;
	}

	.comparison-table td.highlight-val {
		background: rgba(0, 242, 254, 0.02);
	}

	@media (max-width: 768px) {
		.panel-grid {
			grid-template-columns: 1fr;
			gap: 36px;
		}

		.tabs-header {
			border-radius: 12px;
			flex-direction: column;
			gap: 8px;
			padding: 12px;
		}

		.tab-btn {
			border-radius: 8px;
			padding: 10px;
		}

		.tab-btn.active {
			border-radius: 8px;
		}
	}
</style>

<script>
	class EcosystemTabs {
		container: HTMLElement | null = null;
		buttons: NodeListOf<HTMLButtonElement> | null = null;
		panels: NodeListOf<HTMLElement> | null = null;

		constructor() {
			this.container = document.getElementById('coordination') || document.getElementById('partners');
			if (!this.container) return;

			this.buttons = this.container.querySelectorAll('.tab-btn');
			this.panels = this.container.querySelectorAll('.tab-panel');

			this.buttons.forEach(btn => {
				btn.addEventListener('click', () => {
					const tabId = btn.getAttribute('data-tab');
					if (tabId) this.switchTab(tabId, btn);
				});
			});
		}

		switchTab(tabId: string, clickedBtn: HTMLButtonElement) {
			// Deactivate all buttons
			this.buttons?.forEach(btn => btn.classList.remove('active'));
			// Deactivate all panels
			this.panels?.forEach(panel => panel.classList.remove('active'));

			// Activate current button and panel
			clickedBtn.classList.add('active');
			const targetPanel = document.getElementById(tabId);
			targetPanel?.classList.add('active');
		}
	}

	document.addEventListener('DOMContentLoaded', () => {
		new EcosystemTabs();
	});
</script>
