---
---
<section class="bidding-sim" id="bidding-sim">
	<div class="container">
		<div class="section-title-container">
			<span class="section-subtitle">Real-Time Platform Demo</span>
			<h2 class="section-title">Dynamic Spot-Bidding Simulator</h2>
			<p class="section-desc">
				Watch how the platform matches cargo transport needs with vetted carriers, handles demurrage protection, and secures margin spreads automatically.
			</p>
		</div>
		
		<div class="sim-grid">
			<!-- Simulation Control panel and Need card -->
			<div class="sim-card-container">
				<div class="glass-card need-details-card">
					<div class="card-header">
						<span class="category-badge">DRAYAGE / PORT LEG</span>
						<span class="sim-status-badge" id="need-status">Open for Bidding</span>
					</div>
					
					<h3 class="need-title" id="need-title">Transport container JP-9824</h3>
					<p class="need-desc">HTS-Classified engine block assembly from Tokyo, landed at Port of Los Angeles. Relocate to Carson Hub.</p>
					
					<div class="need-specs">
						<div class="spec-row">
							<span class="spec-label">Route:</span>
							<span class="spec-val">Port of LA → Carson 3PL</span>
						</div>
						<div class="spec-row">
							<span class="spec-label">Required Certs:</span>
							<span class="spec-val certs-badges">
								<span class="cert-badge val-badge">Customs Bonded</span>
							</span>
						</div>
						<div class="spec-row">
							<span class="spec-label">Supplier Billed:</span>
							<span class="spec-val text-cyan" id="supplier-billed">$1,200</span>
						</div>
						<div class="spec-row">
							<span class="spec-label">Port Free Time:</span>
							<span class="spec-val font-mono" id="lfd-timer">38h 15m remaining</span>
						</div>
					</div>
					
					<div class="demurrage-alert hidden" id="demurrage-alert">
						<div class="alert-icon-pulsing">!</div>
						<div class="alert-content">
							<span class="alert-title">DEMURRAGE RISK WARNING</span>
							<span class="alert-desc">Under 36 hours until Last Free Day. Escalating carrier payout and broadcasting urgent alerts.</span>
						</div>
					</div>

					<div class="progress-bar-container">
						<div class="progress-bar-label">
							<span>Bidding Window</span>
							<span id="sim-progress-text">Active</span>
						</div>
						<div class="progress-track">
							<div class="progress-fill" id="sim-progress-fill"></div>
						</div>
					</div>
				</div>
			</div>
			
			<!-- Bids Panel -->
			<div class="bids-panel-container">
				<div class="glass-card bids-card">
					<div class="bids-header">
						<h4>Live Bidding Feed</h4>
						<span class="bid-count" id="bid-count">0 Bids</span>
					</div>
					
					<div class="bids-list" id="bids-list">
						<!-- Bids will be injected here by JS -->
						<div class="empty-state" id="bids-empty">Waiting for carriers to join network...</div>
					</div>
					
					<div class="spread-capture-container hidden" id="spread-container">
						<div class="spread-header">
							<h5>Spread Capture Result</h5>
							<span class="success-dot"></span>
						</div>
						<div class="spread-calculations">
							<div class="calc-row">
								<span>Supplier Revenue:</span>
								<span class="calc-val" id="res-billed">$1,200</span>
							</div>
							<div class="calc-row">
								<span>Carrier Payout:</span>
								<span class="calc-val text-red" id="res-carrier">-$890</span>
							</div>
							<div class="calc-row calc-result">
								<span>Musubi Net Spread:</span>
								<span class="calc-val text-green" id="res-spread">+$310 (25.8% Margin)</span>
							</div>
						</div>
						<button class="btn btn-secondary sim-restart-btn" id="restart-sim-btn">Restart Simulator</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.bidding-sim {
		background: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
		position: relative;
	}

	.sim-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 30px;
		align-items: stretch;
		margin-top: 20px;
	}

	.need-details-card {
		padding: 24px;
		display: flex;
		flex-direction: column;
		height: 100%;
		border-left: 4px solid var(--accent-primary);
	}

	.need-details-card.urgent {
		border-left-color: var(--accent-warning);
		animation: pulse-border 1.5s infinite alternate;
	}

	.need-details-card.completed {
		border-left-color: var(--accent-success);
	}

	@keyframes pulse-border {
		0% { border-color: rgba(245, 158, 11, 0.4); }
		100% { border-color: rgba(245, 158, 11, 1); }
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 20px;
	}

	.category-badge {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent-secondary);
		letter-spacing: 0.05em;
	}

	.sim-status-badge {
		background: rgba(255, 255, 255, 0.05);
		padding: 4px 10px;
		border-radius: 9999px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent-primary);
		border: 1px solid rgba(0, 242, 254, 0.1);
	}

	.need-title {
		font-size: 1.4rem;
		margin-bottom: 10px;
		color: var(--text-primary);
	}

	.need-desc {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin-bottom: 24px;
		line-height: 1.5;
	}

	.need-specs {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-bottom: 24px;
		padding: 16px;
		background: rgba(255, 255, 255, 0.02);
		border-radius: 8px;
		border: 1px solid var(--card-border);
	}

	.spec-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.88rem;
	}

	.spec-label {
		color: var(--text-muted);
	}

	.spec-val {
		color: var(--text-primary);
		font-weight: 500;
	}

	.text-cyan {
		color: var(--accent-primary);
		font-weight: 600;
	}

	.demurrage-alert {
		display: flex;
		gap: 12px;
		padding: 14px;
		background: rgba(245, 158, 11, 0.05);
		border: 1px solid rgba(245, 158, 11, 0.2);
		border-radius: 8px;
		margin-bottom: 24px;
		align-items: center;
	}

	.demurrage-alert.hidden {
		display: none;
	}

	.alert-icon-pulsing {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background-color: var(--accent-warning);
		color: #080b11;
		font-weight: 800;
		display: flex;
		align-items: center;
		justify-content: center;
		animation: pulse-icon 1s infinite alternate;
	}

	@keyframes pulse-icon {
		0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7); }
		100% { transform: scale(1.1); box-shadow: 0 0 10px 4px rgba(245, 158, 11, 0); }
	}

	.alert-content {
		display: flex;
		flex-direction: column;
	}

	.alert-title {
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--accent-warning);
	}

	.alert-desc {
		font-size: 0.75rem;
		color: var(--text-secondary);
	}

	.progress-bar-container {
		margin-top: auto;
	}

	.progress-bar-label {
		display: flex;
		justify-content: space-between;
		font-size: 0.8rem;
		color: var(--text-muted);
		margin-bottom: 6px;
		font-weight: 600;
	}

	.progress-track {
		height: 6px;
		background: var(--bg-tertiary);
		border-radius: 3px;
		overflow: hidden;
	}

	.progress-fill {
		height: 100%;
		background: linear-gradient(90deg, var(--accent-primary), var(--accent-blue));
		width: 0%;
		border-radius: 3px;
	}

	/* Bids Panel styling */
	.bids-card {
		padding: 24px;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.bids-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 20px;
		border-bottom: 1px solid var(--card-border);
		padding-bottom: 14px;
	}

	.bids-header h4 {
		font-size: 1.1rem;
		color: var(--text-primary);
	}

	.bid-count {
		font-size: 0.8rem;
		background: rgba(255, 255, 255, 0.05);
		padding: 2px 8px;
		border-radius: 4px;
		color: var(--text-secondary);
	}

	.bids-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
		overflow-y: auto;
		max-height: 240px;
		flex-grow: 1;
		margin-bottom: 20px;
		padding-right: 4px;
	}

	.empty-state {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 150px;
		color: var(--text-muted);
		font-size: 0.9rem;
		text-align: center;
	}

	/* Bid Card */
	.bid-item {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 12px 16px;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--card-border);
		border-radius: 8px;
		animation: slide-in-bid 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
	}

	.bid-item.locked {
		border-color: rgba(239, 68, 68, 0.2);
		background: rgba(239, 68, 68, 0.01);
		opacity: 0.6;
	}

	.bid-item.winning {
		border-color: rgba(16, 185, 129, 0.5);
		background: rgba(16, 185, 129, 0.03);
		box-shadow: 0 0 10px rgba(16, 185, 129, 0.05);
	}

	@keyframes slide-in-bid {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.bid-carrier-info {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.bid-carrier-name {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-primary);
	}

	.bid-status {
		font-size: 0.72rem;
		font-weight: 500;
	}

	.status-compliant { color: var(--accent-success); }
	.status-blocked { color: var(--accent-danger); }

	.bid-pricing {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 2px;
	}

	.bid-amount {
		font-size: 1.05rem;
		font-weight: 700;
		font-family: var(--font-heading);
	}

	.bid-amount.text-green { color: var(--accent-success); }
	.bid-amount.text-red { color: var(--accent-danger); }

	/* Spread Result Card */
	.spread-capture-container {
		background: rgba(16, 185, 129, 0.02);
		border: 1px dashed rgba(16, 185, 129, 0.3);
		border-radius: 10px;
		padding: 16px;
		animation: expand-result 0.4s ease-out forwards;
	}

	.spread-capture-container.hidden {
		display: none;
	}

	@keyframes expand-result {
		from { opacity: 0; transform: scale(0.95); }
		to { opacity: 1; transform: scale(1); }
	}

	.spread-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		padding-bottom: 6px;
	}

	.spread-header h5 {
		font-size: 0.85rem;
		color: var(--text-primary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.success-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background-color: var(--accent-success);
		box-shadow: 0 0 8px var(--accent-success);
	}

	.spread-calculations {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-bottom: 16px;
	}

	.calc-row {
		display: flex;
		justify-content: space-between;
		font-size: 0.85rem;
		color: var(--text-secondary);
	}

	.calc-val {
		font-weight: 600;
		color: var(--text-primary);
	}

	.calc-result {
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding-top: 8px;
		margin-top: 4px;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.calc-result .calc-val {
		font-size: 1rem;
	}

	.text-red { color: var(--accent-danger); }
	.text-green { color: var(--accent-success); }

	.sim-restart-btn {
		width: 100%;
		padding: 10px;
		font-size: 0.85rem;
	}

	@media (max-width: 991px) {
		.sim-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	class BiddingSimulator {
		container: HTMLElement | null = null;
		needStatus: HTMLElement | null = null;
		lfdTimer: HTMLElement | null = null;
		demurrageAlert: HTMLElement | null = null;
		progressFill: HTMLElement | null = null;
		progressText: HTMLElement | null = null;
		bidCount: HTMLElement | null = null;
		bidsList: HTMLElement | null = null;
		bidsEmpty: HTMLElement | null = null;
		spreadContainer: HTMLElement | null = null;
		restartBtn: HTMLElement | null = null;
		needCard: HTMLElement | null = null;
		supplierBilledEl: HTMLElement | null = null;
		
		// Calculation results elements
		resBilled: HTMLElement | null = null;
		resCarrier: HTMLElement | null = null;
		resSpread: HTMLElement | null = null;
		
		timer: number | null = null;
		step = 0;
		progress = 0;
		supplierBilled = 1200;
		hoursLeft = 38.25;

		bidsData = [
			{ time: 1.0, carrier: "Estes Express", amount: 1020, isCompliant: false, reason: "Locked (No Customs Bond)" },
			{ time: 2.0, carrier: "Old Dominion", amount: 950, isCompliant: true },
			{ time: 3.5, carrier: "XPO Logistics", amount: 890, isCompliant: true },
			{ time: 5.5, carrier: "Estes Express (Port authorized)", amount: 1100, isCompliant: true }, // joins after demurrage rate increase
			{ time: 6.5, carrier: "Old Dominion", amount: 820, isCompliant: true },
			{ time: 7.5, carrier: "XPO Logistics", amount: 780, isCompliant: true }
		];

		constructor() {
			this.container = document.getElementById('bidding-sim');
			if (!this.container) return;

			this.needStatus = document.getElementById('need-status');
			this.lfdTimer = document.getElementById('lfd-timer');
			this.demurrageAlert = document.getElementById('demurrage-alert');
			this.progressFill = document.getElementById('sim-progress-fill');
			this.progressText = document.getElementById('sim-progress-text');
			this.bidCount = document.getElementById('bid-count');
			this.bidsList = document.getElementById('bids-list');
			this.bidsEmpty = document.getElementById('bids-empty');
			this.spreadContainer = document.getElementById('spread-container');
			this.restartBtn = document.getElementById('restart-sim-btn');
			this.needCard = document.querySelector('.need-details-card');
			this.supplierBilledEl = document.getElementById('supplier-billed');

			this.resBilled = document.getElementById('res-billed');
			this.resCarrier = document.getElementById('res-carrier');
			this.resSpread = document.getElementById('res-spread');

			this.restartBtn?.addEventListener('click', () => this.startSimulation());
			
			// Start simulation using Intersection Observer to play when visible
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting && this.step === 0 && !this.timer) {
						this.startSimulation();
					}
				});
			}, { threshold: 0.2 });
			
			observer.observe(this.container);
		}

		startSimulation() {
			if (this.timer) clearInterval(this.timer);
			
			this.step = 0;
			this.progress = 0;
			this.hoursLeft = 38.25;
			this.supplierBilled = 1200;
			
			// UI Reset
			if (this.needStatus) {
				this.needStatus.textContent = "Open for Bidding";
				this.needStatus.style.color = "var(--accent-primary)";
			}
			if (this.lfdTimer) this.lfdTimer.textContent = "38h 15m remaining";
			this.demurrageAlert?.classList.add('hidden');
			this.spreadContainer?.classList.add('hidden');
			if (this.bidsList && this.bidsEmpty) {
				this.bidsList.innerHTML = '';
				this.bidsList.appendChild(this.bidsEmpty);
				this.bidsEmpty.classList.remove('hidden');
			}
			if (this.bidCount) this.bidCount.textContent = "0 Bids";
			this.needCard?.classList.remove('urgent', 'completed');
			if (this.progressFill) this.progressFill.style.width = '0%';
			if (this.progressText) this.progressText.textContent = "Active";
			if (this.supplierBilledEl) this.supplierBilledEl.textContent = `$${this.supplierBilled}`;

			// Run loop
			const intervalMs = 1000; // 1 second in sim = 1 unit of time
			this.timer = window.setInterval(() => {
				this.step += 0.5;
				this.progress = (this.step / 9) * 100;
				
				if (this.progressFill) this.progressFill.style.width = `${Math.min(this.progress, 100)}%`;
				
				// Tick LFD Timer down
				this.hoursLeft -= 0.8;
				const hrs = Math.floor(this.hoursLeft);
				const mins = Math.floor((this.hoursLeft - hrs) * 60);
				if (this.lfdTimer) this.lfdTimer.textContent = `${hrs}h ${mins}m remaining`;

				// Demurrage warning threshold (36 hours left)
				if (this.hoursLeft <= 36 && this.hoursLeft > 25) {
					this.triggerDemurrageEscalation();
				}

				// Check for new bids matching the time
				this.bidsData.forEach(bid => {
					if (bid.time === this.step) {
						this.addBid(bid);
					}
				});

				// Finish/Assignment step
				if (this.step >= 9) {
					this.completeBidding();
				}
			}, intervalMs);
		}

		triggerDemurrageEscalation() {
			if (this.needCard?.classList.contains('urgent')) return;
			
			this.needCard?.classList.add('urgent');
			this.demurrageAlert?.classList.remove('hidden');
			
			// Escalation impact
			this.supplierBilled = 1450; // Dynamic surcharge added
			if (this.supplierBilledEl) this.supplierBilledEl.textContent = `$${this.supplierBilled} (+ Port Urgency Spread)`;
			
			if (this.needStatus) {
				this.needStatus.textContent = "Urgent Bidding";
				this.needStatus.style.color = "var(--accent-warning)";
			}
			
			// Inject system log into bids list
			const systemAlert = document.createElement('div');
			systemAlert.style.padding = '8px 12px';
			systemAlert.style.fontSize = '0.75rem';
			systemAlert.style.color = 'var(--accent-warning)';
			systemAlert.style.background = 'rgba(245, 158, 11, 0.05)';
			systemAlert.style.border = '1px solid rgba(245, 158, 11, 0.1)';
			systemAlert.style.borderRadius = '6px';
			systemAlert.style.textAlign = 'center';
			systemAlert.style.margin = '4px 0';
			systemAlert.style.fontWeight = '600';
			systemAlert.textContent = "⚠️ Platform auto-escalated billing and notified tier-1 carriers";
			this.bidsList?.appendChild(systemAlert);
			if (this.bidsList) this.bidsList.scrollTop = this.bidsList.scrollHeight;
		}

		addBid(bid: any) {
			this.bidsEmpty?.classList.add('hidden');
			
			const bidEl = document.createElement('div');
			bidEl.className = `bid-item ${!bid.isCompliant ? 'locked' : ''}`;
			
			const complClass = bid.isCompliant ? 'status-compliant' : 'status-blocked';
			const complLabel = bid.isCompliant ? '✓ Compliant' : `✗ Locked: ${bid.reason}`;
			
			bidEl.innerHTML = `
				<div class="bid-carrier-info">
					<span class="bid-carrier-name">${bid.carrier}</span>
					<span class="bid-status ${complClass}">${complLabel}</span>
				</div>
				<div class="bid-pricing">
					<span class="bid-amount ${bid.isCompliant ? 'text-green' : 'text-red'}">$${bid.amount}</span>
				</div>
			`;
			
			this.bidsList?.appendChild(bidEl);
			if (this.bidsList) this.bidsList.scrollTop = this.bidsList.scrollHeight;
			
			// Update bid count
			const compliantCount = this.bidsList?.querySelectorAll('.bid-item:not(.locked)').length || 0;
			if (this.bidCount) this.bidCount.textContent = `${compliantCount} Compliant Bids`;
		}

		completeBidding() {
			if (this.timer) clearInterval(this.timer);
			this.timer = null;
			
			this.needCard?.classList.remove('urgent');
			this.needCard?.classList.add('completed');
			
			if (this.needStatus) {
				this.needStatus.textContent = "Assigned";
				this.needStatus.style.color = "var(--accent-success)";
			}
			if (this.progressText) this.progressText.textContent = "Completed";

			// Find compliant bid with lowest cost
			// In our hardcoded data, XPO at $780 is the winner
			const winningCarrier = "XPO Logistics";
			const winningPayout = 780;
			const netSpread = this.supplierBilled - winningPayout;
			const marginPercent = ((netSpread / this.supplierBilled) * 100).toFixed(1);

			// Highlight winning bid in UI
			const bidItems = this.bidsList?.querySelectorAll('.bid-item:not(.locked)');
			if (bidItems && bidItems.length > 0) {
				const lastBid = bidItems[bidItems.length - 1] as HTMLElement;
				lastBid.classList.add('winning');
			}

			// Show calculation summary
			if (this.resBilled) this.resBilled.textContent = `$${this.supplierBilled}`;
			if (this.resCarrier) this.resCarrier.textContent = `-$${winningPayout} (${winningCarrier})`;
			if (this.resSpread) this.resSpread.textContent = `+$${netSpread} (${marginPercent}% Margin)`;
			this.spreadContainer?.classList.remove('hidden');
		}
	}

	// Initialize simulator
	document.addEventListener('DOMContentLoaded', () => {
		new BiddingSimulator();
	});
</script>
