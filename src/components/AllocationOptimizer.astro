---
---
<section class="allocation-optimizer" id="optimization">
	<div class="container">
		<div class="section-title-container">
			<span class="section-subtitle" data-i18n="opt.subtitle">Resource & Space Optimization</span>
			<h2 class="section-title" data-i18n="opt.title">Container & Warehouse Allocation Model</h2>
			<p class="section-desc" data-i18n="opt.desc">
				An illustrative model exploring how upfront 3D container planning and multi-hub inventory allocation can reduce wasted air space and unnecessary domestic transfers.
			</p>
		</div>
		
		<div class="optimizer-grid">
			<!-- Interactive Control & Container Utilization Card -->
			<div class="optimizer-card-container">
				<div class="glass-card opt-card">
					<div class="opt-card-header">
						<span class="category-badge" data-i18n="opt.containerBadge">CONTAINER PACKING SIMULATION</span>
						<span class="mode-badge" id="container-mode-badge" data-i18n="opt.modeBadge">Simulation Model</span>
					</div>
					
					<h3 class="opt-card-title" data-i18n="opt.containerTitle">40ft High-Cube Load Planning Model</h3>
					<p class="opt-card-desc" data-i18n="opt.containerDesc">Simulate how pallet orientation and stacking models compare against standard freight loading patterns.</p>
					
					<div class="mode-toggle-group">
						<button class="mode-toggle-btn" id="btn-standard-load" data-i18n="opt.btnStandard">Standard Pattern</button>
						<button class="mode-toggle-btn active" id="btn-optimized-load" data-i18n="opt.btnOptimized">Optimized Pattern</button>
					</div>

					<!-- Visual Container Cross-Section -->
					<div class="container-visual-box">
						<div class="container-frame">
							<div class="container-interior" id="container-grid">
								<!-- Rendered via JS -->
							</div>
						</div>
						<div class="container-stats-bar">
							<div class="stat-pill">
								<span class="pill-label" data-i18n="opt.statPallets">Pallets Positioned:</span>
								<strong class="pill-val" id="pallets-count">24 Positions</strong>
							</div>
							<div class="stat-pill">
								<span class="pill-label" data-i18n="opt.statUtil">Est. Cube Utilization:</span>
								<strong class="pill-val text-cyan" id="utilization-rate">~90-95% (Target)</strong>
							</div>
							<div class="stat-pill">
								<span class="pill-label" data-i18n="opt.statVoid">Void Space:</span>
								<strong class="pill-val text-green" id="wasted-space">&lt; 10% (Target)</strong>
							</div>
						</div>
					</div>

					<div class="financial-impact-banner" id="impact-banner">
						<span class="impact-icon">💡</span>
						<div class="impact-text">
							<strong data-i18n="opt.impactStrong">Optimization Concept:</strong>
							<span id="savings-text" data-i18n="opt.impactText">By modeling pallet dimensions and orientation upfront, the goal is to maximize payload and avoid shipping empty container air.</span>
						</div>
					</div>
				</div>
			</div>
			
			<!-- Multi-Warehouse Allocation & Coordination Card -->
			<div class="optimizer-card-container">
				<div class="glass-card opt-card">
					<div class="opt-card-header">
						<span class="category-badge" data-i18n="opt.hubBadge">3PL HUB ALLOCATION CONCEPT</span>
						<span class="status-indicator-badge" data-i18n="opt.hubIndicator">Illustrative Concept</span>
					</div>
					
					<h3 class="opt-card-title" data-i18n="opt.hubTitle">Regional 3PL Warehouse Routing Model</h3>
					<p class="opt-card-desc" data-i18n="opt.hubDesc">Simulate allocating inbound ocean cargo between West Coast entry hubs and inland distribution centers based on customer demand.</p>
					
					<!-- Allocation Slider -->
					<div class="allocation-slider-block">
						<div class="slider-labels">
							<span data-i18n="opt.sliderWest">West Coast (Carson Hub Concept)</span>
							<span data-i18n="opt.sliderMidwest">Midwest (Detroit Hub Concept)</span>
						</div>
						<input type="range" min="20" max="80" step="5" value="60" class="allocation-slider" id="hub-slider" />
						<div class="slider-metrics">
							<span class="metric-left" id="carson-pct">60% Model (14 Pallets)</span>
							<span class="metric-right" id="midwest-pct">40% Model (10 Pallets)</span>
						</div>
					</div>

					<!-- Warehouse Hub Cards -->
					<div class="hubs-grid">
						<div class="hub-card">
							<div class="hub-header">
								<span class="hub-dot west"></span>
								<strong data-i18n="opt.hub1Name">Pacific Hub (West Coast Concept)</strong>
							</div>
							<span class="hub-location" data-i18n="opt.hub1Loc">Carson, CA (Near Port Corridor)</span>
							<div class="hub-metrics">
								<div class="hub-metric-row">
									<span data-i18n="opt.hub1Row1">Target Drayage Turnaround:</span>
									<strong class="text-green" data-i18n="opt.hub1Row1Val">Fast Port Clearance</strong>
								</div>
								<div class="hub-metric-row">
									<span data-i18n="opt.hub1Row2">Simulated Allocation:</span>
									<strong id="carson-capacity">14 Pallets Planned</strong>
								</div>
							</div>
						</div>

						<div class="hub-card">
							<div class="hub-header">
								<span class="hub-dot midwest"></span>
								<strong data-i18n="opt.hub2Name">Midwest Hub (Inland Concept)</strong>
							</div>
							<span class="hub-location" data-i18n="opt.hub2Loc">Detroit, MI (Industrial Corridor)</span>
							<div class="hub-metrics">
								<div class="hub-metric-row">
									<span data-i18n="opt.hub2Row1">Target OEM Delivery:</span>
									<strong class="text-cyan" data-i18n="opt.hub2Row1Val">Direct Regional Access</strong>
								</div>
								<div class="hub-metric-row">
									<span data-i18n="opt.hub2Row2">Simulated Allocation:</span>
									<strong id="midwest-capacity">10 Pallets Planned</strong>
								</div>
							</div>
						</div>
					</div>

					<!-- Logistics Company Coordination Checklist -->
					<div class="coordination-block">
						<div class="coord-header">
							<span data-i18n="opt.workflowHeader">Planned Coordination Workflow</span>
							<span class="badge-tag tag-success" data-i18n="opt.workflowBadge">Design Model</span>
						</div>
						<div class="coord-steps">
							<div class="coord-step done">
								<span class="step-check">1</span>
								<span data-i18n="opt.wfStep1">Bonded Port Drayage Scheduled with Vetted Carriers</span>
							</div>
							<div class="coord-step done">
								<span class="step-check">2</span>
								<span data-i18n="opt.wfStep2">Warehouse Dock Appointment & Inbound Seal Verification</span>
							</div>
							<div class="coord-step pending">
								<span class="step-check">3</span>
								<span data-i18n="opt.wfStep3">Domestic Intermodal / Final-Mile Dispatch to Distributors</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.allocation-optimizer {
		background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
		position: relative;
		border-bottom: 1px solid var(--card-border);
	}

	.optimizer-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 30px;
		align-items: stretch;
	}

	.opt-card {
		padding: 28px;
		display: flex;
		flex-direction: column;
		height: 100%;
		border-left: 4px solid var(--accent-primary);
	}

	.opt-card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 16px;
	}

	.category-badge {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent-secondary);
		letter-spacing: 0.05em;
	}

	.mode-badge, .status-indicator-badge {
		background: rgba(0, 242, 254, 0.08);
		padding: 4px 10px;
		border-radius: 9999px;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--accent-primary);
		border: 1px solid rgba(0, 242, 254, 0.2);
	}

	.status-indicator-badge {
		background: rgba(16, 185, 129, 0.08);
		color: var(--accent-success);
		border-color: rgba(16, 185, 129, 0.2);
	}

	.opt-card-title {
		font-size: 1.4rem;
		margin-bottom: 8px;
		color: var(--text-primary);
	}

	.opt-card-desc {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin-bottom: 20px;
		line-height: 1.5;
	}

	/* Toggle buttons */
	.mode-toggle-group {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
		margin-bottom: 20px;
	}

	.mode-toggle-btn {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--card-border);
		color: var(--text-secondary);
		padding: 10px;
		border-radius: 8px;
		font-size: 0.88rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.mode-toggle-btn.active {
		border-color: var(--accent-primary);
		background: rgba(0, 242, 254, 0.05);
		color: var(--text-primary);
		box-shadow: 0 0 12px rgba(0, 242, 254, 0.15);
	}

	/* Visual Container */
	.container-visual-box {
		background: rgba(8, 11, 17, 0.5);
		border: 1px solid var(--card-border);
		border-radius: 12px;
		padding: 16px;
		margin-bottom: 20px;
	}

	.container-frame {
		border: 2px solid rgba(255, 255, 255, 0.15);
		border-radius: 8px;
		padding: 8px;
		background: rgba(255, 255, 255, 0.01);
		margin-bottom: 14px;
		position: relative;
	}

	.container-frame::before {
		content: '40ft HC CONTAINER';
		position: absolute;
		top: -9px;
		left: 12px;
		background: var(--bg-secondary);
		padding: 0 6px;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--text-muted);
	}

	.container-interior {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		grid-template-rows: repeat(2, 28px);
		gap: 4px;
	}

	:global(.pallet-slot) {
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.65rem;
		font-weight: 700;
		transition: all 0.3s ease;
	}

	:global(.pallet-slot.filled) {
		background: linear-gradient(135deg, rgba(0, 242, 254, 0.2) 0%, rgba(59, 130, 246, 0.3) 100%);
		border: 1px solid rgba(0, 242, 254, 0.4);
		color: #e0f2fe;
	}

	:global(.pallet-slot.empty) {
		background: rgba(239, 68, 68, 0.05);
		border: 1px dashed rgba(239, 68, 68, 0.25);
		color: var(--accent-danger);
	}

	.container-stats-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding-top: 10px;
	}

	.stat-pill {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.pill-label {
		font-size: 0.72rem;
		color: var(--text-muted);
	}

	.pill-val {
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.text-cyan { color: var(--accent-primary); }
	.text-green { color: var(--accent-success); }

	.financial-impact-banner {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 16px;
		background: rgba(16, 185, 129, 0.04);
		border: 1px solid rgba(16, 185, 129, 0.2);
		border-radius: 8px;
		margin-top: auto;
	}

	.impact-icon {
		font-size: 1.2rem;
		flex-shrink: 0;
	}

	.impact-text {
		font-size: 0.84rem;
		color: var(--text-secondary);
		line-height: 1.4;
	}

	.impact-text strong {
		color: var(--accent-success);
		margin-right: 4px;
	}

	/* Allocation Slider */
	.allocation-slider-block {
		background: rgba(8, 11, 17, 0.5);
		border: 1px solid var(--card-border);
		border-radius: 12px;
		padding: 16px;
		margin-bottom: 20px;
	}

	.slider-labels {
		display: flex;
		justify-content: space-between;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text-secondary);
		margin-bottom: 8px;
	}

	.allocation-slider {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 6px;
		border-radius: 3px;
		background: linear-gradient(90deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
		outline: none;
		margin: 6px 0 10px 0;
	}

	.allocation-slider::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: #ffffff;
		box-shadow: 0 0 10px rgba(0, 242, 254, 0.8);
		cursor: pointer;
	}

	.slider-metrics {
		display: flex;
		justify-content: space-between;
		font-size: 0.85rem;
		font-weight: 700;
	}

	.metric-left { color: var(--accent-primary); }
	.metric-right { color: var(--accent-secondary); }

	/* Hubs Grid */
	.hubs-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
		margin-bottom: 20px;
	}

	.hub-card {
		padding: 14px;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--card-border);
		border-radius: 10px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.hub-header {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.88rem;
		color: var(--text-primary);
	}

	.hub-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}

	.hub-dot.west {
		background: var(--accent-primary);
		box-shadow: 0 0 8px var(--accent-primary);
	}

	.hub-dot.midwest {
		background: var(--accent-secondary);
		box-shadow: 0 0 8px var(--accent-secondary);
	}

	.hub-location {
		font-size: 0.75rem;
		color: var(--text-muted);
		margin-bottom: 6px;
	}

	.hub-metrics {
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding-top: 8px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.hub-metric-row {
		display: flex;
		justify-content: space-between;
		font-size: 0.78rem;
		color: var(--text-secondary);
	}

	/* Coordination block */
	.coordination-block {
		background: rgba(255, 255, 255, 0.01);
		border: 1px solid var(--card-border);
		border-radius: 10px;
		padding: 14px 16px;
		margin-top: auto;
	}

	.coord-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 10px;
	}

	.badge-tag {
		font-size: 0.7rem;
		padding: 2px 8px;
		border-radius: 4px;
	}

	.badge-tag.tag-success {
		background: rgba(16, 185, 129, 0.1);
		color: var(--accent-success);
		border: 1px solid rgba(16, 185, 129, 0.2);
	}

	.coord-steps {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.coord-step {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.8rem;
		color: var(--text-secondary);
	}

	.coord-step.done {
		color: var(--text-primary);
	}

	.step-check {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.7rem;
		font-weight: 800;
	}

	.coord-step.done .step-check {
		background: var(--accent-success);
		color: #080b11;
	}

	.coord-step.pending .step-check {
		background: rgba(255, 255, 255, 0.1);
		color: var(--text-muted);
	}

	@media (max-width: 991px) {
		.optimizer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	class AllocationOptimizer {
		gridEl: HTMLElement | null = null;
		btnStandard: HTMLElement | null = null;
		btnOptimized: HTMLElement | null = null;
		modeBadge: HTMLElement | null = null;
		palletsCount: HTMLElement | null = null;
		utilizationRate: HTMLElement | null = null;
		wastedSpace: HTMLElement | null = null;
		savingsText: HTMLElement | null = null;

		hubSlider: HTMLInputElement | null = null;
		carsonPct: HTMLElement | null = null;
		midwestPct: HTMLElement | null = null;
		carsonCapacity: HTMLElement | null = null;
		midwestCapacity: HTMLElement | null = null;

		isOptimized = true;
		currentLang = 'en';

		constructor() {
			this.gridEl = document.getElementById('container-grid');
			this.btnStandard = document.getElementById('btn-standard-load');
			this.btnOptimized = document.getElementById('btn-optimized-load');
			this.modeBadge = document.getElementById('container-mode-badge');
			this.palletsCount = document.getElementById('pallets-count');
			this.utilizationRate = document.getElementById('utilization-rate');
			this.wastedSpace = document.getElementById('wasted-space');
			this.savingsText = document.getElementById('savings-text');

			this.hubSlider = document.getElementById('hub-slider') as HTMLInputElement;
			this.carsonPct = document.getElementById('carson-pct');
			this.midwestPct = document.getElementById('midwest-pct');
			this.carsonCapacity = document.getElementById('carson-capacity');
			this.midwestCapacity = document.getElementById('midwest-capacity');

			const params = new URLSearchParams(window.location.search);
			const paramLang = params.get('lang');
			const storedLang = typeof localStorage !== 'undefined' ? localStorage.getItem('musubi_lang') : null;
			this.currentLang = (paramLang === 'ja' || paramLang === 'en')
				? paramLang
				: (storedLang === 'ja' || storedLang === 'en')
					? storedLang
					: (document.documentElement.lang || 'en');

			this.btnStandard?.addEventListener('click', () => this.setMode(false));
			this.btnOptimized?.addEventListener('click', () => this.setMode(true));

			this.hubSlider?.addEventListener('input', () => this.updateHubAllocation());

			window.addEventListener('musubi:languageChange', ((e: CustomEvent<{ lang: string }>) => {
				this.currentLang = e.detail?.lang || 'en';
				this.setMode(this.isOptimized);
				this.updateHubAllocation();
			}) as EventListener);

			this.setMode(this.isOptimized);
			this.updateHubAllocation();
		}

		setMode(optimized: boolean) {
			this.isOptimized = optimized;
			const isJa = this.currentLang === 'ja';

			if (this.isOptimized) {
				this.btnOptimized?.classList.add('active');
				this.btnStandard?.classList.remove('active');
				if (this.modeBadge) this.modeBadge.textContent = isJa ? '最適化モデル' : 'Optimized Model';
				if (this.palletsCount) this.palletsCount.textContent = isJa ? '24パレット（構想モデル）' : '24 Positions (Model)';
				if (this.utilizationRate) this.utilizationRate.textContent = isJa ? '~90-95%（目標値）' : '~90-95% (Target)';
				if (this.wastedSpace) this.wastedSpace.textContent = isJa ? '< 10%（目標値）' : '< 10% (Target)';
				if (this.savingsText) {
					this.savingsText.textContent = isJa
						? '目標：パレットの配置方向を事前シミュレーションすることで空気を運ぶ無駄を排除し、必要コンテナ本数の削減を目指します。'
						: 'Target: Pre-calculating pallet orientation helps avoid shipping empty air and aims to reduce the total containers needed.';
				}
			} else {
				this.btnStandard?.classList.add('active');
				this.btnOptimized?.classList.remove('active');
				if (this.modeBadge) this.modeBadge.textContent = isJa ? '通常パターン' : 'Standard Pattern';
				if (this.palletsCount) this.palletsCount.textContent = isJa ? '18パレット（従来型）' : '18 Positions (Baseline)';
				if (this.utilizationRate) this.utilizationRate.textContent = isJa ? '~70-75%（標準値）' : '~70-75% (Typical)';
				if (this.wastedSpace) this.wastedSpace.textContent = isJa ? '~25-30%（従来値）' : '~25-30% (Typical)';
				if (this.savingsText) {
					this.savingsText.textContent = isJa
						? '従来の平積みパターンでは、上部空間や隙間のデッドスペースが多く発生します。'
						: 'Conventional single-layer loading often leaves unoccupied vertical volume and pallet voids.';
				}
			}
			this.renderGrid();
		}

		renderGrid() {
			if (!this.gridEl) return;
			this.gridEl.innerHTML = '';
			const totalSlots = 24;
			const filledSlots = this.isOptimized ? 24 : 18;
			const isJa = this.currentLang === 'ja';

			for (let i = 0; i < totalSlots; i++) {
				const slot = document.createElement('div');
				const isFilled = i < filledSlots;
				slot.className = `pallet-slot ${isFilled ? 'filled' : 'empty'}`;
				slot.textContent = isFilled ? `P${i + 1}` : (isJa ? '空隙' : 'Void');
				this.gridEl.appendChild(slot);
			}
		}

		updateHubAllocation() {
			if (!this.hubSlider) return;
			const westPctVal = parseInt(this.hubSlider.value);
			const eastPctVal = 100 - westPctVal;

			const totalPallets = 24;
			const carsonPallets = Math.round((westPctVal / 100) * totalPallets);
			const midwestPallets = totalPallets - carsonPallets;
			const isJa = this.currentLang === 'ja';

			if (this.carsonPct) {
				this.carsonPct.textContent = isJa
					? `${westPctVal}% モデル (${carsonPallets} パレット)`
					: `${westPctVal}% Model (${carsonPallets} Pallets)`;
			}
			if (this.midwestPct) {
				this.midwestPct.textContent = isJa
					? `${eastPctVal}% モデル (${midwestPallets} パレット)`
					: `${eastPctVal}% Model (${midwestPallets} Pallets)`;
			}

			if (this.carsonCapacity) {
				this.carsonCapacity.textContent = isJa
					? `${carsonPallets} パレット予定`
					: `${carsonPallets} Pallets Planned`;
			}
			if (this.midwestCapacity) {
				this.midwestCapacity.textContent = isJa
					? `${midwestPallets} パレット予定`
					: `${midwestPallets} Pallets Planned`;
			}
		}
	}

	document.addEventListener('DOMContentLoaded', () => {
		new AllocationOptimizer();
	});
</script>
