---
---
<section class="factoring-calc" id="factoring-calc">
	<div class="container">
		<div class="section-title-container">
			<span class="section-subtitle">Platform FinTech & Liquidity</span>
			<h2 class="section-title">Musubi FastPay & Factoring Calculator</h2>
			<p class="section-desc">
				Bridge the gap between Japanese suppliers requesting prompt payment and US distributors demanding Net 60/90 credit terms.
			</p>
		</div>
		
		<div class="calc-grid">
			<!-- Inputs -->
			<div class="calc-inputs-container">
				<div class="glass-card calc-card">
					<h3 class="calc-card-title">Configure Financing Parameters</h3>
					
					<div class="input-group">
						<div class="input-label-row">
							<label for="invoice-slider">Invoice Face Value</label>
							<span class="slider-display" id="invoice-display">$50,000</span>
						</div>
						<input type="range" min="5000" max="150000" step="5000" value="50000" class="slider" id="invoice-slider" />
						<div class="slider-bounds">
							<span>$5K</span>
							<span>$150K</span>
						</div>
					</div>
					
					<div class="input-group">
						<label class="group-title">Distributor Credit Terms</label>
						<div class="terms-btn-group">
							<button class="term-btn" data-days="30">Net 30</button>
							<button class="term-btn active" data-days="60">Net 60</button>
							<button class="term-btn" data-days="90">Net 90</button>
						</div>
					</div>
					
					<div class="input-group check-group">
						<label class="checkbox-container">
							<input type="checkbox" id="fastpay-check" checked />
							<span class="checkmark"></span>
							<div class="checkbox-text">
								<strong>Opt-In to FastPay Carrier Escrow</strong>
								<span>Release funds to freight carriers immediately upon warehouse delivery confirmation (1.5% ACH Escrow fee).</span>
							</div>
						</label>
					</div>
				</div>
			</div>
			
			<!-- Outputs -->
			<div class="calc-outputs-container">
				<div class="glass-card result-card">
					<h3 class="calc-card-title">Liquidity Allocation Summary</h3>
					
					<div class="calc-ledger">
						<div class="ledger-row">
							<span>Gross Invoice Value:</span>
							<span class="ledger-val" id="led-gross">$50,000</span>
						</div>
						
						<div class="ledger-row ledger-deduct">
							<span>Musubi Factoring Fee (<span id="led-term-pct">3.0%</span>):</span>
							<span class="ledger-val text-red" id="led-factor-fee">-$1,500</span>
						</div>
						
						<div class="ledger-row ledger-deduct" id="led-fastpay-row">
							<span>FastPay Escrow Service (1.5%):</span>
							<span class="ledger-val text-red" id="led-fastpay-fee">-$750</span>
						</div>
						
						<div class="ledger-row ledger-total">
							<span>Immediate Cash Release:</span>
							<span class="ledger-val text-green" id="led-net-payout">$47,750</span>
						</div>
					</div>
					
					<div class="timeline-visual">
						<div class="timeline-bar-wrapper">
							<span class="timeline-label">Traditional Cash Collection:</span>
							<div class="timeline-track">
								<div class="timeline-bar bar-wait" style="width: 100%;">Waiting 60 Days</div>
							</div>
						</div>
						
						<div class="timeline-bar-wrapper">
							<span class="timeline-label">Musubi Cash Flow:</span>
							<div class="timeline-track">
								<div class="timeline-bar bar-instant" style="width: 15%;">24-Hour ACH Release</div>
							</div>
						</div>
					</div>
					
					<div class="trade-flow-visual" id="trade-flow">
						<div class="flow-step">
							<span class="flow-node">Supplier</span>
							<span class="flow-desc">Invoice: <strong id="flow-invoice-val">$50,000</strong></span>
						</div>
						<div class="flow-arrow">➡️</div>
						<div class="flow-step">
							<span class="flow-node highlight">Musubi</span>
							<span class="flow-desc">Pays <strong id="flow-net-pct">95.5%</strong> (<strong id="flow-net-payout">$47,750</strong>) Instantly</span>
						</div>
						<div class="flow-arrow">➡️</div>
						<div class="flow-step">
							<span class="flow-node">Distributor</span>
							<span class="flow-desc">Pays <strong id="flow-distributor-val">$50,000</strong> in <strong id="flow-term-days">60</strong> Days</span>
						</div>
					</div>
					
					<div class="cashflow-benefit-badge">
						<span class="benefit-title">LIQUIDITY METRIC</span>
						<p class="benefit-desc">Improves cash conversion cycle by <strong id="led-days-saved">59 days</strong>. Maintain raw material purchases with zero cash-gap interruptions.</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.factoring-calc {
		background: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
		border-bottom: 1px solid var(--card-border);
	}

	.calc-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 30px;
		align-items: stretch;
	}

	.calc-card {
		padding: 28px;
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.calc-card-title {
		font-size: 1.15rem;
		border-bottom: 1px solid var(--card-border);
		padding-bottom: 12px;
		color: var(--text-primary);
	}

	.input-group {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.input-label-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.input-label-row label {
		font-size: 0.9rem;
		color: var(--text-secondary);
		font-weight: 500;
	}

	.slider-display {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		font-weight: 800;
		color: var(--accent-primary);
	}

	/* Slider Custom Styling */
	.slider {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 6px;
		border-radius: 3px;
		background: var(--bg-tertiary);
		outline: none;
		margin: 8px 0;
	}

	.slider::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: var(--accent-primary);
		box-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
		cursor: pointer;
		transition: transform 0.1s ease;
	}

	.slider::-webkit-slider-thumb:hover {
		transform: scale(1.2);
	}

	.slider-bounds {
		display: flex;
		justify-content: space-between;
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.group-title {
		font-size: 0.9rem;
		color: var(--text-secondary);
		font-weight: 500;
	}

	.terms-btn-group {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12px;
	}

	.term-btn {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--card-border);
		color: var(--text-secondary);
		padding: 10px;
		border-radius: 8px;
		cursor: pointer;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.88rem;
		transition: all 0.2s ease;
	}

	.term-btn:hover {
		background: rgba(255, 255, 255, 0.05);
		color: var(--text-primary);
	}

	.term-btn.active {
		border-color: var(--accent-secondary);
		background: rgba(139, 92, 246, 0.05);
		color: #ffffff;
		box-shadow: 0 0 10px rgba(139, 92, 246, 0.1);
	}

	/* Checkbox Styling */
	.check-group {
		margin-top: 8px;
	}

	.checkbox-container {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		cursor: pointer;
		font-size: 0.85rem;
		position: relative;
		user-select: none;
	}

	.checkbox-container input {
		position: absolute;
		opacity: 0;
		cursor: pointer;
		height: 0;
		width: 0;
	}

	.checkmark {
		width: 20px;
		height: 20px;
		background-color: var(--bg-tertiary);
		border: 1.5px solid var(--card-border);
		border-radius: 4px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
	}

	.checkbox-container:hover input ~ .checkmark {
		border-color: var(--accent-primary);
	}

	.checkbox-container input:checked ~ .checkmark {
		background-color: var(--accent-primary);
		border-color: var(--accent-primary);
	}

	.checkmark::after {
		content: "";
		display: none;
		width: 5px;
		height: 10px;
		border: solid #080b11;
		border-width: 0 2.5px 2.5px 0;
		transform: rotate(45deg) translate(-1px, -1px);
	}

	.checkbox-container input:checked ~ .checkmark::after {
		display: block;
	}

	.checkbox-text {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.checkbox-text strong {
		color: var(--text-primary);
		font-weight: 600;
	}

	.checkbox-text span {
		color: var(--text-secondary);
		line-height: 1.4;
	}

	/* Result Card */
	.result-card {
		padding: 28px;
		background: rgba(21, 28, 46, 0.4);
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.calc-ledger {
		display: flex;
		flex-direction: column;
		gap: 12px;
		background: rgba(8, 11, 17, 0.3);
		border: 1px solid var(--card-border);
		border-radius: 12px;
		padding: 18px;
	}

	.ledger-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.9rem;
		color: var(--text-secondary);
	}

	.ledger-deduct {
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		padding-bottom: 8px;
	}

	.ledger-val {
		font-family: var(--font-heading);
		font-weight: 700;
	}

	.ledger-total {
		padding-top: 8px;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.ledger-total .ledger-val {
		font-size: 1.25rem;
	}

	/* Timelines */
	.timeline-visual {
		display: flex;
		flex-direction: column;
		gap: 14px;
		border-top: 1px solid var(--card-border);
		padding-top: 18px;
	}

	.timeline-bar-wrapper {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.timeline-label {
		font-size: 0.78rem;
		color: var(--text-muted);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	.timeline-track {
		height: 24px;
		background: var(--bg-primary);
		border-radius: 6px;
		overflow: hidden;
		border: 1px solid var(--card-border);
		position: relative;
	}

	.timeline-bar {
		height: 100%;
		display: flex;
		align-items: center;
		padding-left: 12px;
		font-size: 0.75rem;
		font-weight: 700;
		transition: width 0.4s ease;
	}

	.bar-wait {
		background: rgba(239, 68, 68, 0.1);
		color: var(--accent-danger);
		border-right: 2px solid var(--accent-danger);
	}

	.bar-instant {
		background: linear-gradient(90deg, rgba(16, 185, 129, 0.2), rgba(16, 185, 129, 0.4));
		color: var(--accent-success);
		border-right: 2px solid var(--accent-success);
		box-shadow: 0 0 10px rgba(16, 185, 129, 0.15);
	}

	/* Benefit Badge */
	.cashflow-benefit-badge {
		padding: 14px;
		background: rgba(0, 242, 254, 0.03);
		border: 1px solid rgba(0, 242, 254, 0.1);
		border-radius: 8px;
		margin-top: auto;
	}

	.benefit-title {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent-primary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		display: block;
		margin-bottom: 4px;
	}

	.benefit-desc {
		font-size: 0.82rem;
		line-height: 1.4;
	}

	.benefit-desc strong {
		color: var(--accent-primary);
	}

	.trade-flow-visual {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 16px;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--card-border);
		border-radius: 10px;
		margin-top: 10px;
		gap: 6px;
	}

	.flow-step {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		flex: 1;
	}

	.flow-node {
		background: var(--bg-primary);
		border: 1px solid var(--card-border);
		padding: 6px 12px;
		border-radius: 6px;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--text-primary);
		margin-bottom: 6px;
	}

	.flow-node.highlight {
		border-color: var(--accent-primary);
		color: var(--accent-primary);
		box-shadow: 0 0 10px rgba(0, 242, 254, 0.15);
	}

	.flow-desc {
		font-size: 0.7rem;
		color: var(--text-muted);
		line-height: 1.3;
	}

	.flow-desc strong {
		color: var(--text-primary);
	}

	.flow-arrow {
		color: var(--accent-primary);
		font-size: 0.95rem;
		animation: pulse-arrow 1.5s infinite ease-in-out;
		margin-bottom: 22px;
	}

	@keyframes pulse-arrow {
		0% { transform: translateX(-2px); opacity: 0.5; }
		50% { transform: translateX(2px); opacity: 1; }
		100% { transform: translateX(-2px); opacity: 0.5; }
	}

	@media (max-width: 991px) {
		.calc-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	class FactoringCalculator {
		invoiceSlider: HTMLInputElement | null = null;
		invoiceDisplay: HTMLElement | null = null;
		termButtons: NodeListOf<HTMLButtonElement> | null = null;
		fastpayCheck: HTMLInputElement | null = null;
		
		ledGross: HTMLElement | null = null;
		ledTermPct: HTMLElement | null = null;
		ledFactorFee: HTMLElement | null = null;
		ledFastpayFee: HTMLElement | null = null;
		ledFastpayRow: HTMLElement | null = null;
		ledNetPayout: HTMLElement | null = null;
		ledDaysSaved: HTMLElement | null = null;
		
		waitBar: HTMLElement | null = null;
		instantBar: HTMLElement | null = null;
		
		flowInvoiceVal: HTMLElement | null = null;
		flowNetPayout: HTMLElement | null = null;
		flowNetPct: HTMLElement | null = null;
		flowTermDays: HTMLElement | null = null;
		flowDistributorVal: HTMLElement | null = null;

		invoiceValue = 50000;
		termDays = 60;
		fastpayEnabled = true;

		constructor() {
			const container = document.getElementById('factoring-calc');
			if (!container) return;

			this.invoiceSlider = document.getElementById('invoice-slider') as HTMLInputElement;
			this.invoiceDisplay = document.getElementById('invoice-display');
			this.termButtons = container.querySelectorAll('.term-btn');
			this.fastpayCheck = document.getElementById('fastpay-check') as HTMLInputElement;
			
			this.ledGross = document.getElementById('led-gross');
			this.ledTermPct = document.getElementById('led-term-pct');
			this.ledFactorFee = document.getElementById('led-factor-fee');
			this.ledFastpayFee = document.getElementById('led-fastpay-fee');
			this.ledFastpayRow = document.getElementById('led-fastpay-row');
			this.ledNetPayout = document.getElementById('led-net-payout');
			this.ledDaysSaved = document.getElementById('led-days-saved');

			this.waitBar = container.querySelector('.bar-wait');
			this.instantBar = container.querySelector('.bar-instant');
			
			this.flowInvoiceVal = document.getElementById('flow-invoice-val');
			this.flowNetPayout = document.getElementById('flow-net-payout');
			this.flowNetPct = document.getElementById('flow-net-pct');
			this.flowTermDays = document.getElementById('flow-term-days');
			this.flowDistributorVal = document.getElementById('flow-distributor-val');

			// Event listeners
			this.invoiceSlider?.addEventListener('input', () => {
				this.invoiceValue = parseInt(this.invoiceSlider?.value || '50000');
				this.calculate();
			});

			this.termButtons.forEach(btn => {
				btn.addEventListener('click', () => {
					this.termButtons?.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					this.termDays = parseInt(btn.getAttribute('data-days') || '60');
					this.calculate();
				});
			});

			this.fastpayCheck?.addEventListener('change', () => {
				this.fastpayEnabled = this.fastpayCheck?.checked || false;
				this.calculate();
			});

			this.calculate();
		}

		calculate() {
			// Slider label
			if (this.invoiceDisplay) this.invoiceDisplay.textContent = `$${this.invoiceValue.toLocaleString()}`;
			
			// Factoring fee percentage based on term
			// 30 days = 2.0%, 60 days = 3.0%, 90 days = 4.0%
			let factorPct = 3.0;
			if (this.termDays === 30) factorPct = 2.0;
			else if (this.termDays === 90) factorPct = 4.0;

			const factorFee = (this.invoiceValue * factorPct) / 100;
			const fastpayFee = this.fastpayEnabled ? (this.invoiceValue * 1.5) / 100 : 0;
			const netPayout = this.invoiceValue - factorFee - fastpayFee;
			const daysSaved = this.termDays - 1; // Released in 24 hours (1 day)

			// Update ledger
			if (this.ledGross) this.ledGross.textContent = `$${this.invoiceValue.toLocaleString()}`;
			if (this.ledTermPct) this.ledTermPct.textContent = `${factorPct.toFixed(1)}%`;
			if (this.ledFactorFee) this.ledFactorFee.textContent = `-$${factorFee.toLocaleString()}`;
			
			if (this.ledFastpayRow) {
				if (this.fastpayEnabled) {
					this.ledFastpayRow.style.display = 'flex';
					if (this.ledFastpayFee) this.ledFastpayFee.textContent = `-$${fastpayFee.toLocaleString()}`;
				} else {
					this.ledFastpayRow.style.display = 'none';
				}
			}

			if (this.ledNetPayout) this.ledNetPayout.textContent = `$${netPayout.toLocaleString()}`;
			if (this.ledDaysSaved) this.ledDaysSaved.textContent = `${daysSaved} days`;

			// Update timelines
			if (this.waitBar) {
				this.waitBar.textContent = `Waiting ${this.termDays} Days`;
			}
			
			if (this.instantBar) {
				// Width calculation relative to wait days
				// e.g. 1 day / 60 days = 1.6% width, let's keep a min-width of 15% so it's readable
				const pctWidth = Math.max(12, (1 / this.termDays) * 100);
				this.instantBar.style.width = `${pctWidth}%`;
			}

			// Update flow visual details
			const netPct = (100 - factorPct - (this.fastpayEnabled ? 1.5 : 0)).toFixed(1);
			if (this.flowInvoiceVal) this.flowInvoiceVal.textContent = `$${this.invoiceValue.toLocaleString()}`;
			if (this.flowNetPayout) this.flowNetPayout.textContent = `$${netPayout.toLocaleString()}`;
			if (this.flowNetPct) this.flowNetPct.textContent = `${netPct}%`;
			if (this.flowTermDays) this.flowTermDays.textContent = `${this.termDays}`;
			if (this.flowDistributorVal) this.flowDistributorVal.textContent = `$${this.invoiceValue.toLocaleString()}`;
		}
	}

	document.addEventListener('DOMContentLoaded', () => {
		new FactoringCalculator();
	});
</script>
