---
---
<section class="contact-section" id="demo">
	<div class="container">
		<div class="section-title-container">
			<span class="section-subtitle" data-i18n="contact.subtitle">Get in Touch</span>
			<h2 class="section-title" data-i18n="contact.title">Connect with Our Logistics Team</h2>
			<p class="section-desc" data-i18n="contact.desc">
				Whether you are an exporter seeking corridor visibility, a 3PL warehouse or carrier coordinating space, or an importer streamlining distribution, we're here to help.
			</p>
		</div>
		
		<div class="contact-grid">
			<!-- Contact Pitch Card -->
			<div class="pitch-card-container">
				<div class="glass-card info-pitch-card">
					<h3 data-i18n="contact.pitchTitle">Customer Discovery & Feedback</h3>
					<p class="pitch-card-lead" data-i18n="contact.pitchLead">We are in early exploratory talks with precision parts manufacturers, 3PL warehouses, and distributors to design a platform grounded in real logistics workflows.</p>
					
					<div class="info-list">
						<div class="info-item">
							<span class="info-icon">📍</span>
							<div class="info-text">
								<strong data-i18n="contact.officeUS">USA Operations</strong>
								<span>Carson Corridor Logistics Hub, Carson, CA</span>
							</div>
						</div>
						<div class="info-item">
							<span class="info-icon">📍</span>
							<div class="info-text">
								<strong data-i18n="contact.officeJP">Japan Liaison</strong>
								<span>Naka-ku, Nagoya, Aichi Prefecture</span>
							</div>
						</div>
						<div class="info-item">
							<span class="info-icon">✉</span>
							<div class="info-text">
								<strong data-i18n="contact.officeInq">Logistics Inquiries</strong>
								<span>operations@musubi.com</span>
							</div>
						</div>
					</div>
					
					<div class="pitch-tag-glow">
						<span data-i18n="contact.tagGlow">💡 Early Concept Stage • Exploring Pilot Partners & Workflow Input</span>
					</div>
				</div>
			</div>
			
			<!-- Contact Form Card -->
			<div class="form-card-container">
				<div class="glass-card form-card">
					<!-- Form Tab Swappers -->
					<div class="form-tabs">
						<button class="form-tab-btn active" data-form-role="exporter" data-i18n="contact.tabExp">Manufacturer</button>
						<button class="form-tab-btn" data-form-role="partner" data-i18n="contact.tabLog">3PL & Carrier</button>
						<button class="form-tab-btn" data-form-role="distributor" data-i18n="contact.tabDist">Distributor / Importer</button>
					</div>
					
					<!-- Form Fields Box -->
					<form id="contact-form" class="form-body">
						<input type="hidden" id="form-role-input" value="exporter" />
						
						<div class="form-group-row">
							<div class="form-group">
								<label for="company-name" id="label-company" data-i18n="contact.labelCompany">Company Name</label>
								<input type="text" id="company-name" placeholder="Nakamura Seiki Ltd." required />
							</div>
							<div class="form-group">
								<label for="contact-name" data-i18n="contact.labelContact">Contact Name</label>
								<input type="text" id="contact-name" placeholder="Taro Nakamura" required />
							</div>
						</div>
						
						<div class="form-group">
							<label for="contact-email" data-i18n="contact.labelEmail">Email Address</label>
							<input type="email" id="contact-email" placeholder="contact@company.com" required />
						</div>
						
						<!-- Dynamic Field Block 1 -->
						<div class="form-group" id="dynamic-field-container">
							<label for="dynamic-select" id="label-dynamic" data-i18n="contact.labelVolume">Estimated Monthly Volume</label>
							<select id="dynamic-select">
								<option value="low">Under 5 containers / month</option>
								<option value="medium">5 to 20 containers / month</option>
								<option value="high">20+ containers / month</option>
							</select>
						</div>
						
						<div class="form-group">
							<label for="message" data-i18n="contact.labelMsg">Message / Specific Requirements</label>
							<textarea id="message" rows="4" placeholder="How can we help optimize your supply chain corridor?" required></textarea>
						</div>
						
						<button type="submit" class="btn btn-primary form-submit-btn" data-i18n="contact.btnSubmit">Send Message / Schedule a Chat</button>
					</form>
					
					<!-- Success Message Panel -->
					<div class="success-panel hidden" id="success-panel">
						<div class="success-icon">✓</div>
						<h3 data-i18n="contact.successTitle">Message Received</h3>
						<p data-i18n="contact.successDesc">Thank you for reaching out. We look forward to connecting and discussing your supply chain workflows.</p>
						<button class="btn btn-secondary btn-sm" id="reset-form-btn" data-i18n="contact.btnReset">Submit Another Message</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.contact-section {
		background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
		position: relative;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 40px;
		align-items: stretch;
	}

	.info-pitch-card {
		padding: 30px;
		display: flex;
		flex-direction: column;
		height: 100%;
		border-left: 4px solid var(--accent-secondary);
	}

	.info-pitch-card h3 {
		font-size: 1.5rem;
		margin-bottom: 12px;
		color: var(--text-primary);
	}

	.pitch-card-lead {
		font-size: 0.98rem;
		color: var(--text-secondary);
		margin-bottom: 32px;
		line-height: 1.5;
	}

	.info-list {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.info-item {
		display: flex;
		gap: 16px;
		align-items: flex-start;
	}

	.info-icon {
		width: 32px;
		height: 32px;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--card-border);
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.95rem;
		flex-shrink: 0;
	}

	.info-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		font-size: 0.9rem;
	}

	.info-text strong {
		color: var(--text-primary);
		font-weight: 600;
	}

	.info-text span {
		color: var(--text-secondary);
	}

	.pitch-tag-glow {
		margin-top: auto;
		background: rgba(139, 92, 246, 0.05);
		border: 1px solid rgba(139, 92, 246, 0.15);
		padding: 12px;
		border-radius: 8px;
		text-align: center;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent-secondary);
	}

	/* Form Card styling */
	.form-card {
		padding: 30px;
		position: relative;
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.form-tabs {
		display: flex;
		border-bottom: 1px solid var(--card-border);
		margin-bottom: 24px;
		gap: 12px;
	}

	.form-tab-btn {
		background: transparent;
		border: none;
		color: var(--text-secondary);
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 600;
		padding: 10px 4px;
		cursor: pointer;
		position: relative;
		transition: color 0.2s ease;
	}

	.form-tab-btn:hover {
		color: var(--text-primary);
	}

	.form-tab-btn.active {
		color: var(--accent-primary);
	}

	.form-tab-btn.active::after {
		content: '';
		position: absolute;
		bottom: -1px;
		left: 0;
		width: 100%;
		height: 2px;
		background-color: var(--accent-primary);
		box-shadow: 0 2px 8px var(--accent-primary);
	}

	/* Form elements */
	.form-body {
		display: flex;
		flex-direction: column;
		gap: 18px;
		flex-grow: 1;
	}

	.form-body.hidden {
		display: none;
	}

	.form-group-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.form-group label {
		font-size: 0.82rem;
		color: var(--text-secondary);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	.form-group input, 
	.form-group select, 
	.form-group textarea {
		background: rgba(8, 11, 17, 0.5);
		border: 1px solid var(--card-border);
		border-radius: 8px;
		padding: 12px;
		color: var(--text-primary);
		font-family: var(--font-body);
		font-size: 0.9rem;
		outline: none;
		transition: all 0.2s ease;
	}

	.form-group input:focus, 
	.form-group select:focus, 
	.form-group textarea:focus {
		border-color: var(--accent-primary);
		box-shadow: 0 0 10px rgba(0, 242, 254, 0.15);
		background: rgba(8, 11, 17, 0.8);
	}

	.form-submit-btn {
		margin-top: 10px;
		width: 100%;
		padding: 14px;
	}

	/* Success Panel */
	.success-panel {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		flex-grow: 1;
		gap: 16px;
		padding: 30px 10px;
		animation: expand-result 0.4s ease-out forwards;
	}

	.success-panel.hidden {
		display: none;
	}

	.success-icon {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: var(--accent-success);
		color: #080b11;
		font-size: 1.5rem;
		font-weight: 800;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
	}

	.success-panel h3 {
		font-size: 1.4rem;
		color: var(--text-primary);
	}

	.success-panel p {
		font-size: 0.92rem;
		color: var(--text-secondary);
		max-width: 320px;
		margin-bottom: 8px;
	}

	@media (max-width: 991px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 480px) {
		.form-group-row {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	class ContactForm {
		container: HTMLElement | null = null;
		tabButtons: NodeListOf<HTMLButtonElement> | null = null;
		form: HTMLFormElement | null = null;
		roleInput: HTMLInputElement | null = null;
		successPanel: HTMLElement | null = null;
		resetBtn: HTMLElement | null = null;
		
		// Dynamic labels & inputs
		labelCompany: HTMLElement | null = null;
		companyInput: HTMLInputElement | null = null;
		contactInput: HTMLInputElement | null = null;
		messageInput: HTMLTextAreaElement | null = null;
		labelDynamic: HTMLElement | null = null;
		dynamicSelect: HTMLSelectElement | null = null;
		dynamicFieldContainer: HTMLElement | null = null;

		activeRole: 'exporter' | 'partner' | 'distributor' = 'exporter';
		currentLang: 'en' | 'ja' = 'en';

		// Bilingual Form role settings config
		roleConfig = {
			en: {
				exporter: {
					labelCompany: "Company / Manufacturer Name",
					companyPlaceholder: "Nakamura Seiki Ltd.",
					contactPlaceholder: "Taro Nakamura",
					msgPlaceholder: "Tell us about your export cargo, parts specifications, or customs needs...",
					dynamicLabel: "Estimated Monthly Shipping Volume",
					dynamicOptions: [
						{ val: "low", text: "Under 5 containers / month" },
						{ val: "medium", text: "5 to 20 containers / month" },
						{ val: "high", text: "20+ containers / month" }
					]
				},
				partner: {
					labelCompany: "3PL or Carrier Organization",
					companyPlaceholder: "Pacific Logistics Hub Inc.",
					contactPlaceholder: "Sarah Jenkins",
					msgPlaceholder: "Provide details on your warehouse space, drayage fleet, or preferred lanes...",
					dynamicLabel: "Logistics Partner Type",
					dynamicOptions: [
						{ val: "warehouse", text: "3PL Warehouse Operator" },
						{ val: "carrier-drayage", text: "Bonded Port Drayage Carrier" },
						{ val: "carrier-ltl", text: "FTL/LTL Regional Carrier" }
					]
				},
				distributor: {
					labelCompany: "Distributor / Importer Name",
					companyPlaceholder: "Precision Auto Supply LLC",
					contactPlaceholder: "David Miller",
					msgPlaceholder: "Which industrial products do you distribute? What regional hubs do you need?",
					dynamicLabel: "Primary US Distribution Corridor",
					dynamicOptions: [
						{ val: "west", text: "West Coast (California Corridor)" },
						{ val: "midwest", text: "Midwest (Detroit / Chicago Corridor)" },
						{ val: "national", text: "Multi-Regional / Nationwide" }
					]
				}
			},
			ja: {
				exporter: {
					labelCompany: "貴社名・製造業名",
					companyPlaceholder: "例：中村精機株式会社",
					contactPlaceholder: "例：中村 太郎",
					msgPlaceholder: "輸出品目、部品仕様、通関書類の現状課題などをご記入ください...",
					dynamicLabel: "想定月間出荷量",
					dynamicOptions: [
						{ val: "low", text: "月5コンテナ未満" },
						{ val: "medium", text: "月5〜20コンテナ" },
						{ val: "high", text: "月20コンテナ以上" }
					]
				},
				partner: {
					labelCompany: "3PL倉庫・物流会社名",
					companyPlaceholder: "例：パシフィック・ロジスティクス株式会社",
					contactPlaceholder: "例：佐藤 健",
					msgPlaceholder: "倉庫スペース、保有車両、対応可能な輸送区間についてお聞かせください...",
					dynamicLabel: "物流パートナーの種別",
					dynamicOptions: [
						{ val: "warehouse", text: "3PL倉庫事業者" },
						{ val: "carrier-drayage", text: "保税港湾ドレージ運送業者" },
						{ val: "carrier-ltl", text: "FTL/LTL 地域運送会社" }
					]
				},
				distributor: {
					labelCompany: "販売先・輸入者名",
					companyPlaceholder: "例：プレシジョン・オートサプライLLC",
					contactPlaceholder: "例：鈴木 一郎",
					msgPlaceholder: "取り扱い工業製品や、希望する米国内拠点エリアについてお聞かせください...",
					dynamicLabel: "主に対象とする米国内エリア",
					dynamicOptions: [
						{ val: "west", text: "西海岸（カリフォルニア周辺）" },
						{ val: "midwest", text: "中西部（デトロイト / シカゴ周辺）" },
						{ val: "national", text: "全米 / 複数地域" }
					]
				}
			}
		};

		constructor() {
			this.container = document.querySelector('.contact-section');
			if (!this.container) return;

			const params = new URLSearchParams(window.location.search);
			const paramLang = params.get('lang');
			const storedLang = typeof localStorage !== 'undefined' ? localStorage.getItem('musubi_lang') : null;
			this.currentLang = (paramLang === 'ja' || paramLang === 'en')
				? paramLang
				: (storedLang === 'ja' || storedLang === 'en')
					? storedLang
					: ((document.documentElement.lang as 'en' | 'ja') || 'en');

			this.tabButtons = this.container.querySelectorAll('.form-tab-btn');
			this.form = document.getElementById('contact-form') as HTMLFormElement;
			this.roleInput = document.getElementById('form-role-input') as HTMLInputElement;
			this.successPanel = document.getElementById('success-panel');
			this.resetBtn = document.getElementById('reset-form-btn');
			
			this.labelCompany = document.getElementById('label-company');
			this.companyInput = document.getElementById('company-name') as HTMLInputElement;
			this.contactInput = document.getElementById('contact-name') as HTMLInputElement;
			this.messageInput = document.getElementById('message') as HTMLTextAreaElement;
			
			this.labelDynamic = document.getElementById('label-dynamic');
			this.dynamicSelect = document.getElementById('dynamic-select') as HTMLSelectElement;
			this.dynamicFieldContainer = document.getElementById('dynamic-field-container');

			this.tabButtons.forEach(btn => {
				btn.addEventListener('click', () => {
					const role = btn.getAttribute('data-form-role') as 'exporter' | 'partner' | 'distributor';
					if (role) {
						this.activeRole = role;
						this.switchFormRole(role, btn);
					}
				});
			});

			window.addEventListener('musubi:languageChange', ((e: CustomEvent<{ lang: 'en' | 'ja' }>) => {
				this.currentLang = e.detail?.lang || 'en';
				const activeBtn = Array.from(this.tabButtons || []).find(
					b => b.getAttribute('data-form-role') === this.activeRole
				);
				this.switchFormRole(this.activeRole, activeBtn || null);
			}) as EventListener);

			this.form?.addEventListener('submit', (e) => {
				e.preventDefault();
				this.handleSubmit();
			});

			this.resetBtn?.addEventListener('click', () => this.resetForm());

			this.switchFormRole(this.activeRole, null);
		}

		switchFormRole(role: 'exporter' | 'partner' | 'distributor', clickedBtn: HTMLButtonElement | null) {
			if (clickedBtn) {
				this.tabButtons?.forEach(btn => btn.classList.remove('active'));
				clickedBtn.classList.add('active');
			}

			if (this.roleInput) this.roleInput.value = role;

			const langConfig = this.roleConfig[this.currentLang] || this.roleConfig['en'];
			const config = langConfig[role];
			if (!config) return;

			// Update Labels and Placeholders
			if (this.labelCompany) this.labelCompany.textContent = config.labelCompany;
			if (this.companyInput) this.companyInput.placeholder = config.companyPlaceholder;
			if (this.contactInput) this.contactInput.placeholder = config.contactPlaceholder;
			if (this.messageInput) this.messageInput.placeholder = config.msgPlaceholder;

			// Update Dynamic Dropdown Options
			if (this.labelDynamic) this.labelDynamic.textContent = config.dynamicLabel;
			if (this.dynamicSelect) {
				const currentVal = this.dynamicSelect.value;
				this.dynamicSelect.innerHTML = '';
				config.dynamicOptions.forEach(opt => {
					const optionEl = document.createElement('option');
					optionEl.value = opt.val;
					optionEl.textContent = opt.text;
					if (opt.val === currentVal) optionEl.selected = true;
					this.dynamicSelect?.appendChild(optionEl);
				});
			}
		}

		handleSubmit() {
			// Simulate API request send
			if (this.form) this.form.classList.add('hidden');
			if (this.successPanel) this.successPanel.classList.remove('hidden');
		}

		resetForm() {
			if (this.form) {
				this.form.reset();
				this.form.classList.remove('hidden');
			}
			if (this.successPanel) this.successPanel.classList.add('hidden');
		}
	}

	document.addEventListener('DOMContentLoaded', () => {
		new ContactForm();
	});
</script>
